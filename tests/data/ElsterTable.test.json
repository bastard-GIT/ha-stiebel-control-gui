 "types": [
  {
   "id": 0,
   "name": "et_default",
   "signed": true,
   "scale": 1,
   "decode": "int16 (signed), dezimal",
   "encode": "Ganzzahl -32767..65535 -> uint16",
   "writable": true,
   "example": {
    "raw": "0xfffe",
    "text": "-2"
   }
  },
  {
   "id": 1,
   "name": "et_dec_val",
   "signed": true,
   "scale": 0.1,
   "decode": "int16 (signed) / 10, 1 Nachkommastelle",
   "encode": "wert*10 (abgeschnitten), Bereich +-32767",
   "writable": true,
   "example": {
    "raw": "0x00d2",
    "text": "21.0"
   }
  },
  {
   "id": 2,
   "name": "et_cent_val",
   "signed": true,
   "scale": 0.01,
   "decode": "int16 (signed) / 100, 2 Nachkommastellen",
   "encode": "wert*100, Bereich +-32767",
   "writable": true,
   "example": {
    "raw": "0x0096",
    "text": "1.50"
   }
  },
  {
   "id": 3,
   "name": "et_mil_val",
   "signed": true,
   "scale": 0.001,
   "decode": "int16 (signed) / 1000, 3 Nachkommastellen",
   "encode": "wert*1000, Bereich +-32767",
   "writable": true,
   "example": {
    "raw": "0x03e8",
    "text": "1.000"
   }
  },
  {
   "id": 4,
   "name": "et_byte",
   "signed": true,
   "scale": 1,
   "decode": "NUR Low-Byte (raw & 0xFF) als int8 (signed)",
   "encode": "Ganzzahl 0..255",
   "writable": true,
   "example": {
    "raw": "0x0005",
    "text": "5"
   }
  },
  {
   "id": 5,
   "name": "et_bool",
   "signed": false,
   "scale": 1,
   "decode": "0x0001 oder 0x0100 -> 'on', 0x0000 -> 'off', sonst '?' (beide Byte-Reihenfolgen, wie Upstream 2.3.0/2.4.0)",
   "encode": "'on' -> 0x0001, 'off' -> 0x0000",
   "writable": true,
   "example": {
    "raw": "0x0001",
    "text": "on"
   }
  },
  {
   "id": 6,
   "name": "et_little_bool",
   "signed": false,
   "scale": 1,
   "decode": "0x0001 oder 0x0100 -> 'on', 0x0000 -> 'off', sonst '?' (beide Byte-Reihenfolgen, wie Upstream 2.3.0/2.4.0)",
   "encode": "'on' -> 0x0100, 'off' -> 0x0000",
   "writable": true,
   "example": {
    "raw": "0x0100",
    "text": "on"
   }
  },
  {
   "id": 7,
   "name": "et_double_val",
   "signed": false,
   "scale": 1,
   "decode": "raw uint16, formatiert mit 3 Nachkommastellen (nur 16 Bit, kein echtes 32-Bit-Double)",
   "encode": null,
   "writable": false,
   "example": {
    "raw": "0x04d2",
    "text": "1234.000"
   }
  },
  {
   "id": 8,
   "name": "et_triple_val",
   "signed": false,
   "scale": 1,
   "decode": "raw uint16, formatiert mit 6 Nachkommastellen (nur 16 Bit)",
   "encode": null,
   "writable": false,
   "example": {
    "raw": "0x04d2",
    "text": "1234.000000"
   }
  },
  {
   "id": 9,
   "name": "et_little_endian",
   "signed": false,
   "scale": 1,
   "decode": "Bytes tauschen, dann uint16: (raw>>8) + 256*(raw&0xFF)",
   "encode": "Ganzzahl -> Bytes tauschen",
   "writable": true,
   "example": {
    "raw": "0x0100",
    "text": "1"
   }
  },
  {
   "id": 10,
   "name": "et_betriebsart",
   "signed": false,
   "scale": 1,
   "decode": "nur wenn Low-Byte==0 und High-Byte<=6: betriebsart_list[High-Byte].name, sonst '?'",
   "encode": "Name per Praefix-Match gegen betriebsart_list (von hinten nach vorn) -> Listenindex als High-Byte",
   "writable": true,
   "example": {
    "raw": "0x0200",
    "text": "Programmbetrieb"
   }
  },
  {
   "id": 11,
   "name": "et_zeit",
   "signed": false,
   "scale": 1,
   "decode": "Low-Byte = Stunde, High-Byte = Minute; 'HH:MM'",
   "encode": "'H:M' -> (min<<8)+hour; hour<24, min<60",
   "writable": true,
   "example": {
    "raw": "0x1e0d",
    "text": "13:30"
   }
  },
  {
   "id": 12,
   "name": "et_datum",
   "signed": false,
   "scale": 1,
   "decode": "High-Byte = Tag, Low-Byte = Monat; 'DD.MM.'",
   "encode": "'D.M.' -> (tag<<8)+monat; Tag 1-31, Monat 1-12, Plausibilitaet je Monat",
   "writable": true,
   "example": {
    "raw": "0x1405",
    "text": "20.05."
   }
  },
  {
   "id": 13,
   "name": "et_time_domain",
   "signed": false,
   "scale": 1,
   "decode": "raw&0x8080 -> 'not used time domain'; sonst Start=High-Byte, Ende=Low-Byte, jeweils in Viertelstunden: 'HH:MM-HH:MM'",
   "encode": "'H:M-H:M' -> ((4*h1+m1/15)<<8) + (4*h2+m2/15), Start<Ende; leerer String -> 0x8080",
   "writable": true,
   "example": {
    "raw": "0x1c40",
    "text": "07:00-16:00"
   }
  },
  {
   "id": 14,
   "name": "et_dev_nr",
   "signed": false,
   "scale": 1,
   "decode": "raw>=0x80 -> '--', sonst raw+1",
   "encode": null,
   "writable": false,
   "example": {
    "raw": "0x0000",
    "text": "1"
   }
  },
  {
   "id": 15,
   "name": "et_err_nr",
   "signed": false,
   "scale": 1,
   "decode": "Lookup in error_list; unbekannt -> 'ERR <dezimal>'",
   "encode": null,
   "writable": false,
   "example": {
    "raw": "0x0004",
    "text": "Hochdruck"
   }
  },
  {
   "id": 16,
   "name": "et_dev_id",
   "signed": false,
   "scale": 1,
   "decode": "'<High-Byte>-<Low-Byte 2-stellig>'",
   "encode": null,
   "writable": false,
   "example": {
    "raw": "0x0201",
    "text": "2-01"
   }
  }
 ],
